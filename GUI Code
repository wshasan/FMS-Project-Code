  }

  let dToTarget = dist(activeCircle.x, activeCircle.y, centerX, centerY);
  // Top hedefin içindeyse VE sürüklenmiyor/bırakılmışsa puanla
  if (dToTarget < TARGET_RADIUS * 0.7 && !activeCircle.dragging) { 
    score1++;
    activeCircle.resetPosition();
    if (score1 >= 15) {
      gameOver = true;
    } else {
      currentTargetIndex = (currentTargetIndex + 1) % circles2.length;
    }
  }

  releaseFinishedTouches();
}

