function drawExcercise4(){
    background(255);
  strokeWeight(2);
  for (let c of circles2) {
    const d = dist(c.x, c.y, CX, CY);
    stroke(d > c.initialDist ? 'red' : 'green');
    line(c.x, c.y, CX, CY);
  }
  for (let c of circles2) {
    c.update();
    c.show();
  }
  releaseFinishedTouches();
}

function mousePressed() {

  // --- Exercise 3: circle popping ---
  if (exerciseToEnter === 3 && gameState === 'playing') {
    for (let i = circles.length - 1; i >= 0; i--) {
      let c = circles[i];
      let d = dist(mouseX, mouseY, c.x, c.y);
      if (d < c.size / 2) {
        circles.splice(i, 1);
        score++;
        break;
      }
    }
    return; 
  }

  // --- Exercise 4: draggable circles ---
  if (exerciseToEnter === 4) {
    for (let i = circles2.length - 1; i >= 0; i--) {
      if (circles2[i].tryGrabAt(mouseX, mouseY, "mouse")) break;
    }
    return;
  }
}

function mouseReleased() {
  for (let c of circles2) c.releaseIf("mouse");
}

function touchStarted() {
  for (let t of touches) {
    for (let i = circles2.length - 1; i >= 0; i--) {
      if (!circles2[i].dragging && circles2[i].tryGrabAt(t.x, t.y, t.id)) break;
    }
  }
  return false;
}
function touchMoved() { return false; }
function touchEnded() { releaseFinishedTouches(); return false; }

function getTouchById(id) {
  for (let t of touches) if (t.id === id) return t;
  return null;
}
function releaseFinishedTouches() {
  for (let c of circles2) {
    if (c.touchId !== null && c.touchId !== "mouse") {
      const stillActive = getTouchById(c.touchId);
      if (!stillActive) c.release();
    }
  }
}
