function drawExercise3(){
  
  textFont(font);

  if (bg3){
    background(bg3);
  }

  if (gameState === 'playing') {
    if (circles.length < maxCircles && random(1) < 0.02) {
      let newCircle = {
        x: random(50, width - 50),
        y: random(50, height - 50),
        size: circleSize,
        lifetime: lifetime
      };

      let overlapping = false;
      for (let c of circles) {
        let d = dist(newCircle.x, newCircle.y, c.x, c.y);
        if (d < (newCircle.size / 2 + c.size / 2)) {
          overlapping = true;
          break;
        }
      }

      if (!overlapping) circles.push(newCircle);
    }

    for (let i = circles.length - 1; i >= 0; i--) {
      let c = circles[i];
      fill('#white');
      strokeWeight(3);
      stroke('#eae0c8');
      circle(c.x, c.y, c.size);
      noStroke();

      c.lifetime--;
      if (c.lifetime <= 0) circles.splice(i, 1);
    }

    let elapsedTime = millis() - startTime;
    let timeRemaining = totalTime - Math.floor(elapsedTime / 1000);

    textSize(80);
    fill(0);
    textAlign(CENTER, CENTER);
    if (timeRemaining > 0) {
      text(timeRemaining, (width / 2), height - 720);
    } else {
      gameState = 'gameOver';
    }
    
    textSize(40);
    textAlign(CENTER, CENTER);
    text(`pearl: ${score}`, (width / 2), height - 660);
    
} else if (gameState === 'gameOver') {
    background(bg32); 

    textAlign(CENTER, CENTER);

    fill('white');
    stroke('#eae0c8');
    textSize(80);
    text(`you've got ${score} pearls`, width / 2, height - 150);

    noLoop();
  }
  
  noStroke();
  fill('black'); 
  rect(0, 0, width, 15);
  rect(0, height - 15, width, 15);
  rect(0, 0, 15, height);
  rect(width - 15, 0, 15, height);
}

