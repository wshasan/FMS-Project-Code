function mousePressed() {
  // Egzersiz 3 ve diğerlerinin tıklamalarına izin verir, sadece Egzersiz 4 için sürüklemeyi başlatır.
  if (exerciseToEnter === 4 && !gameOver) {
    for (let i = circles2.length - 1; i >= 0; i--) {
      // Sadece hedeflenen dairenin sürüklenmesine izin ver
      if (i === currentTargetIndex && circles2[i].tryGrabAt(mouseX, mouseY, "mouse")) {
        break;
      }
    }
  }
  // Diğer egzersizlerin fare olaylarını almasına izin vermek için return false ile sonlandırılmaz.
  // Ancak p5.js'te tarayıcı kaydırmasını engellemek için genellikle false döndürülür.
  // Bu yüzden en alta ekliyoruz:
  return false;
}

function mouseReleased() {
  if (exerciseToEnter === 4 && !gameOver) {
    for (let c of circles2) c.releaseIf("mouse");
  }
}

function touchStarted() {
  // Egzersiz 4 dışında her egzersiz için, tarayıcı kaydırmasını engellemek için sadece `return false` yapılır.
  if (exerciseToEnter !== 4 || gameOver) {
    return false; 
  }
  
  // Egzersiz 4 mantığı
  for (let t of touches) {
    for (let i = circles2.length - 1; i >= 0; i--) {
      // Sadece hedeflenen dairenin sürüklenmesine izin ver
      if (i === currentTargetIndex && !circles2[i].dragging && circles2[i].tryGrabAt(t.x, t.y, t.id)) {
        break;
      }
    }
  }
  return false;
}

function touchMoved() {
  if (exerciseToEnter !== 4 || gameOver) return false;
  return false;
}

function touchEnded() {
  if (exerciseToEnter === 4 && !gameOver) releaseFinishedTouches();
  return false;
}

function getTouchById(id) {
  for (let t of touches) {
    if (t.id === id) return t;
  }
  return null;
}

function releaseFinishedTouches() {
  for (let c of circles2) {
    if (c.touchId !== null && c.touchId !== "mouse") {
      const stillActive = getTouchById(c.touchId);
      if (!stillActive) c.release();
    }
  }
}

class DraggableCircle {
  constructor(x, y, r) {
    this.x = x;
    this.y = y;
    this.r = r;
    this.dragging = false;
    this.touchId = null;
    this.offsetX = 0;
    this.offsetY = 0;
    this.homeX = x;
    this.homeY = y;
    this.fingerName = "";
  }

  tryGrabAt(px, py, pid) {
    const d = dist(px, py, this.x, this.y);
    if (d < this.r && !this.dragging) {
      this.dragging = true;
      this.touchId = pid;
      this.offsetX = this.x - px;
      this.offsetY = this.y - py;
      return true;
    }
    return false;
  }

  update() {
    if (!this.dragging || gameOver) return;
    if (this.touchId === "mouse") {
      this.x = mouseX + this.offsetX;
      this.y = mouseY + this.offsetY;
    } else {
      const t = getTouchById(this.touchId);
      if (t) {
        this.x = t.x + this.offsetX;
        this.y = t.y + this.offsetY;
      }
    }
  }

  releaseIf(pid) {
    if (this.touchId === pid) this.release();
  }

  release() {
    this.dragging = false;
    this.touchId = null;
  }

  resetPosition() {
    this.x = this.homeX;
    this.y = this.homeY;
    this.dragging = false;
    this.touchId = null;
  }

  show() {
    let isActive = this === circles2[currentTargetIndex] && !gameOver;
    stroke(0);
    strokeWeight(isActive ? 4 : 1);
    fill(this.dragging ? 120 : isActive ? 180 : 220);
    circle(this.x, this.y, this.r * 2);
  }
}
